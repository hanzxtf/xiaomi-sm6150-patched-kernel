# Camera
CONFIG_LDO_WL2866D=y
CONFIG_SPECTRA_CAMERA_UPGRADE=y

# Compass
CONFIG_AKM09970=y

# Device
CONFIG_MACH_XIAOMI_SWEET=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FS_TEE=y

# Haptics
CONFIG_INPUT_AW8624_HAPTIC=y
# CONFIG_LEDS_QPNP_HAPTICS is not set
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set

# IR
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y

# MMC
CONFIG_MMC=y
# CONFIG_MMC_PERF_PROFILING is not set
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_BLOCK_DEFERRED_RESUME=y
# CONFIG_MMC_TEST is not set
CONFIG_MMC_PARANOID_SD_INIT=y
CONFIG_MMC_CLKGATE=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_CQ_HCI=y
CONFIG_MMC_CQ_HCI_CRYPTO=y
CONFIG_MMC_CQ_HCI_CRYPTO_QTI=y

# NFC
CONFIG_NFC_NQ_PN80T=y
# CONFIG_NFC_NQ is not set

# Power
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_CHARGER_LN8000=y
CONFIG_K6_CHARGE=y
CONFIG_ONEWIRE_GPIO=y
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_SMB1390_CHARGE_PUMP_PSY is not set

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"

# Step motor
CONFIG_TI_DRV8846=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX9896_I2C=y
CONFIG_TOUCHSCREEN_FTS_K6=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_NEW_TOUCH_GAMEMODE=y
CONFIG_TOUCHSCREEN_TDDI_DBCLK=y

# Ultrasound proxmity
CONFIG_US_PROXIMITY=y

# NetHunter: general
CONFIG_SYSVIPC=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_DEFAULT_HOSTNAME="kali"

# NetHunter: USB gadget attacks
CONFIG_USB_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y

# NetHunter: radio bridging
CONFIG_BRIDGE_NETFILTER=y

# NetHunter: external wireless adapters
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_ATH_COMMON=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_MT7601U=y
CONFIG_RT2X00=y
CONFIG_RT2500USB=y
CONFIG_RT73USB=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RTL8187=y
CONFIG_RTL_CARDS=y
CONFIG_RTL8192CU=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_88XXAU=y
CONFIG_RTW88=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8822CU=y
CONFIG_RTW88_8723DU=y
CONFIG_RTW88_8821CU=y
CONFIG_RTW88_8812AU=y
CONFIG_RTW88_8814AU=y
CONFIG_USB_ZD1201=y
CONFIG_ZD1211RW=y
CONFIG_USB_NET_RNDIS_WLAN=y
